<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource SemiLightBlue9}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
    <Style Selector="Border.MainPageCard">
        <Setter Property="Margin" Value="0 15 0 5"/>
        <Setter Property="Padding" Value="10 15 10 5"/>
        <Setter Property="Background" Value="{StaticResource SemiGrey8}"/>
    </Style>

    <Style Selector="TextBlock.Title">
        <Setter Property="Margin" Value="0 10 0 0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Foreground" Value="{StaticResource SemiColorInformation}"/>
    </Style>
        
</Styles>